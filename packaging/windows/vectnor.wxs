<?xml version="1.0" encoding="utf-8"?>
<!--
  Vectnor MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build vectnor.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc vectnor.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder (Program Files\Vectnor by
  default, remembered for upgrades), Ready, a progress page, and a Finish page with a ticked
  "Launch Vectnor" box. Installs a Start Menu shortcut and an App Paths entry (so `vectnor`
  starts from the Run dialog), plus vectnor-cli. `msiexec /qn` still installs silently.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Vectnor"
      Manufacturer="Appaji Ambarisha"
      Version="$(var.Version)"
      UpgradeCode="601C6437-08AE-4645-ADCC-27F036C2EA2F"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Vectnor vector illustration app" Manufacturer="Appaji Ambarisha" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Vectnor is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="VectnorIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="VectnorIcon.ico" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Vectnor" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by VectnorApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\Vectnor" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="Vectnor" Level="1">
      <ComponentGroupRef Id="VectnorFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchVectnor"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through vectnor.en-us.wxl. -->
    <Property Id="VectnorVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Vectnor $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Vectnor" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#VectnorExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchVectnor" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="VectnorFiles" Directory="INSTALLFOLDER">
      <Component Id="VectnorApp" Guid="0E8C6C5E-DE4A-4E1D-9DB0-44E8E38C2103">
        <File Id="VectnorExe" Source="$(var.BinDir)\vectnor.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Vectnor"
              Description="Vectnor vector illustration app" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="VectnorIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\vectnor.exe" Value="[#VectnorExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Vectnor" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="VectnorDocumentIcon">
        <File Id="VectnorDocumentIconFile" Source="$(var.BinDir)\document.ico" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.vcnr" Value="Vectnor.Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Vectnor.Document" Value="Vectnor Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Vectnor.Document\DefaultIcon" Value="[#VectnorDocumentIconFile],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Vectnor.Document\shell\open\command" Value="&quot;[#VectnorExe]&quot; &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="VectnorCli">
        <File Id="VectnorCliExe" Source="$(var.BinDir)\vectnor-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
