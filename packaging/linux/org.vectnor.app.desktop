[Desktop Entry]
Type=Application
Name=Vectnor
GenericName=Vector Graphics Editor
Comment=Draw and edit vector illustrations, SVG and PDF
Exec=vectnor %F
TryExec=vectnor
Icon=org.vectnor.app
Terminal=false
StartupNotify=true
